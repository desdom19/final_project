@page
@using final_project.Models
@model final_project.Pages_Meals.AddDeleteModel

@{
    ViewData["Title"] = "Add/Delete Ingredient";
}

<h1>Add/Delete Ingredient</h1>

<div>
    <h4>Meal</h4>
    <hr />
    <div class="container">
        <div class="row">
        <div class = "col-md-6">
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Meal.MealName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Meal.MealName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Meal.MealIngredients)
        </dt>
        <dd class ="col-sm-10">
            <dl class="row">
            @foreach(var ingredient in Model.Meal.MealIngredients!){
                <dl class="mb-4">
                 <dt class="mb-2">
                    @Html.DisplayFor(model => ingredient.Ingredient.IngredientName)
                </dt> 
            
                <dd class="col-sm-8">
                    @Html.DisplayNameFor(model => ingredient.Ingredient.FoodCategory):
                    @Html.DisplayFor(model => ingredient.Ingredient.FoodCategory)
                </dd> 

                <dd class="col-sm-8">
                    @Html.DisplayNameFor(model => ingredient.Ingredient.StorageType):
                    @Html.DisplayFor(model => ingredient.Ingredient.StorageType)
                </dd> 

                <dd class="col-sm-8">
                    @Html.DisplayNameFor(model => ingredient.Ingredient.ExpirationTime):
                    @Html.DisplayFor(model => ingredient.Ingredient.ExpirationTime)
                </dd> 

                <dd class="col-sm-8">
                    @Html.DisplayNameFor(model => ingredient.Ingredient.IngredientCalories):
                    @Html.DisplayFor(model => ingredient.Ingredient.IngredientCalories)
                </dd> 

                <dd class="col-sm-8">
                    @Html.DisplayNameFor(model => ingredient.Ingredient.IngredientCost):
                    @ingredient.Ingredient.IngredientCost.ToString("C")
                </dd> 

                <dd class="col-sm-8">
                    @Html.DisplayNameFor(model => ingredient.Quantity):
                    @ingredient.Quantity
                </dd> 

                 <dd class="col-sm-8">
                    @Html.DisplayNameFor(model => ingredient.Ingredient.UnitMeasurement):
                    @Html.DisplayFor(model => ingredient.Ingredient.UnitMeasurement)
                </dd> 

                <form method="post">
                    <input type="hidden" asp-for="IngredientIDToDelete" value="@ingredient.Ingredient.IngredientID" />
                    <button type="submit" class="btn btn-danger btn-sm my-1" asp-page-handler="RemoveIngredient" asp-route-id="@Model.Meal.MealID">Remove Ingredient</button>
                </form>

                </dl>           
            }
                
        </dl>   
    </dd>

        <form method="post">
            <div class="row align-items-center">
                <dt class="col-sm-2">
                    <label asp-for="IngredientIDToAdd" class="control-label"></label>
                </dt>
                <div class="col-auto">
                    <select asp-for="IngredientIDToAdd" asp-items="Model.IngredientsDropDown" class="form-select">
                        <option value="">Choose...</option>
                    </select>
                </div>
                <div class="col-auto">
                    <input type="number" step="0.01" min="0.01" max="999.99" asp-for="AddedIngredientQuantity" placeholder="Quantity" class="form-control"/>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary" asp-page-handler="AddIngredient" asp-route-id="@Model.Meal.MealID">Add Ingredient</button>
                </div>
                <div class="col-auto">
                    <span asp-validation-for="IngredientIDToAdd" class="text-danger"></span>
                </div>
            </div>
        </form>

        <form method="post" asp-page-handler="DoneCreating" asp-route-id="@Model.Meal.MealID">
            <button type="submit" class="btn btn-primary mt-3">Done</button>
        </form>

        

        
    </dl>

    </div>




<div class="col-md-6">
    <h2>Reference Table: Ingredient Measurements</h2>
        <table class="table">
            <thead>
                <tr>
                    <th>
                        Ingredient Name
                    </th>
                    <th>
                        Unit of Measurement
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach(var ingredient in Model.AllIngredients!){
                    <tr>
                        <td>@Html.DisplayFor(model => ingredient.IngredientName)</td>
                        <td>@Html.DisplayFor(model => ingredient.UnitMeasurement)</td> 
                    </tr>          
                }   
             </tbody>  
        </table>

</div>
        </div>
    </div>





<div>
    <a asp-page="./Edit" asp-route-id="@Model.Meal.MealID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

