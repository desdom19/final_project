@page
@model final_project.Pages_Meals.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Meal</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Meal.MealName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Meal.MealName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Meal.TimeCategory)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Meal.TimeCategory)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Meal.PreparationTime)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Meal.PreparationTime)
        </dd>
        <dd class="col-sm-2">
            <strong>Total Calories</strong>
        </dd>
        <dd class="col-sm-10">
            @Model.CaloriesTotal
        </dd>
        <dd class="col-sm-2">
            <strong>Total Cost</strong>
        </dd>
        <dd class="col-sm-10">
            @Model.CostTotal.ToString("C")
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Meal.MealID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
